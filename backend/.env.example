# Copy this file to .env and fill in real values.
# Sentinel will run in mock mode for Razorpay/LLM calls if these are left blank,
# so the demo still works without live keys -- but real keys show the real integration.

# LLM_PROVIDER: "anthropic" (direct) or "openrouter"
LLM_PROVIDER=openrouter

# Only one of these needs to be set, matching LLM_PROVIDER above.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Model name -- for openrouter, use their namespaced format.
LLM_MODEL=anthropic/claude-sonnet-4.5

# API key from backend/.env is required on every request. A dev-mode
# key is used only if SENTINEL_API_KEY is unset -- an unauthenticated
# API in front of a system whose whole point is trust and access control
# would be a real, visible gap, not just a nice-to-have.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SENTINEL_DATABASE_URL=postgresql://sentinel:sentinel@localhost:5432/sentinel
SENTINEL_API_KEY=

# Redis-backed cache/queue -- set both to "redis" for a multi-replica
# deployment (see docker-compose.yml). Leave as "memory" (or unset) for
# single-instance local dev; both fall back to in-memory automatically
# if Redis is unreachable, with a logged warning.
CACHE_BACKEND=memory
QUEUE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# A stable identifier for this replica -- shown in /health, useful for
# confirming a load balancer is actually distributing across replicas.
SENTINEL_INSTANCE_ID=local

# Per-API-key rate limiting (sliding window). Defaults are generous for
# local dev; tighten for anything resembling a real deployment.
SENTINEL_RATE_LIMIT_REQUESTS=60
SENTINEL_RATE_LIMIT_WINDOW_SECONDS=60

# NEVER commit a real .env file or paste real key values in chat/docs.
# Rotate any key immediately if it is ever pasted somewhere outside this file.
