# Use scripts/setup_dev.py for generated local credentials. Never commit .env.
SENTINEL_ENV=development
SENTINEL_DATABASE_URL=postgresql://sentinel:CHANGE_ME@localhost:5432/sentinel
# JSON entries: unique key (32+ characters), subject, role, and owner_id/agent_ids.
# Roles: admin; owner (owner_id); reviewer (owner_id); agent (agent_ids).
SENTINEL_CREDENTIALS=[]
# Legacy shared key is permitted only outside production, for local testing.
SENTINEL_API_KEY=
SENTINEL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
QUEUE_BACKEND=memory
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0
SENTINEL_RATE_LIMIT_REQUESTS=60
SENTINEL_RATE_LIMIT_WINDOW_SECONDS=60
SENTINEL_INSTANCE_ID=local
