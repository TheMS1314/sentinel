# Use scripts/setup_dev.py for generated local credentials. Never commit .env.
SENTINEL_ENV=development
SENTINEL_DATABASE_URL=postgresql://sentinel:CHANGE_ME@localhost:5432/sentinel
# JSON entries: unique key (32+ characters), subject, role, and owner_id/agent_ids.
# Roles: admin; owner (owner_id); reviewer (owner_id); agent (agent_ids).
SENTINEL_CREDENTIALS=[]
# Shared production authority: initialize explicitly; revoked keys are never re-seeded.
SENTINEL_AUTH_BACKEND=configured
# Legacy shared key is permitted only outside production, for local testing.
SENTINEL_API_KEY=
SENTINEL_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
QUEUE_BACKEND=memory
# Production: QUEUE_BACKEND=postgres; Redis streams are legacy/development only.
RATE_LIMIT_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0
SENTINEL_RATE_LIMIT_REQUESTS=60
SENTINEL_RATE_LIMIT_WINDOW_SECONDS=60
SENTINEL_INSTANCE_ID=local

# Runtime bounds. Tune against measured workload and database connection budget.
SENTINEL_ALLOWED_HOSTS=localhost,127.0.0.1
SENTINEL_TRUSTED_PROXY_IPS=127.0.0.1
SENTINEL_REQUIRE_MIGRATIONS=0
SENTINEL_DB_POOL_SIZE=10
SENTINEL_DB_OVERFLOW=0
SENTINEL_DB_POOL_TIMEOUT_SECONDS=3
SENTINEL_DB_STATEMENT_MS=10000
SENTINEL_DB_LOCK_MS=2000
SENTINEL_DB_IDLE_MS=15000
SENTINEL_HTTP_CONCURRENCY=32
SENTINEL_SERVER_CONCURRENCY=64
SENTINEL_MAX_BODY_BYTES=524288
SENTINEL_LLM_CONCURRENCY=4
SENTINEL_LLM_TIMEOUT_SECONDS=10
SENTINEL_QUEUE_WORKERS=4
SENTINEL_JOB_MAX_AGE_SECONDS=300
SENTINEL_JOB_RETENTION_HOURS=24
SENTINEL_APPROVAL_TTL_SECONDS=300
SENTINEL_DISPATCH_STALE_SECONDS=120
SENTINEL_SHUTDOWN_SECONDS=30
